{
  "name": "dsh-novel-solo",
  "version": "0.1.7",
  "description": "novel-solo helper for DeepSeek Harness: a subagent-count setting (1-12) card on the plugin page, saved into the host settings, mirrored to disk and consumed by the novel-solo preset to cap parallel subagent fan-out.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "dsh-plugin",
    "novel",
    "settings"
  ],
  "license": "MIT",
  "author": "Tkingxiao",
  "homepage": "https://github.com/Tkingxiao/dsh-novel-solo#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tkingxiao/dsh-novel-solo.git"
  },
  "bugs": {
    "url": "https://github.com/Tkingxiao/dsh-novel-solo/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./plugins": {
      "default": "./template/plugins/llm-tool-choice-pin/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "main": "lib/index.js",
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "template"
  ],
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js && node scripts/sync-preset-patch.mjs --check"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-locale": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.2",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ],
      "immediately": true
    }
  }
}